# Git attributes for the gitbash project

# Normalize line endings
* text=auto

# Python and scientific computing
*.py text eol=lf
*.pyi text eol=lf
*.ipynb text eol=lf

# Documentation and configuration
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Data
*.csv text eol=lf
*.tsv text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xlsx binary
*.docx binary
*.zip binary
*.parquet binary
*.npy binary
*.npz binary
*.pkl binary
*.joblib binary
*.db binary
